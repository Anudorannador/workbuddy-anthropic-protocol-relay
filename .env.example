# Copy to .env and adjust. .env is git-ignored.
# Do not put API keys here: the relay takes the key from the inbound request.

RELAY_PORT=8787
RELAY_HOST=127.0.0.1

# Anthropic-compatible upstream
RELAY_UPSTREAM_HOST=api.anthropic.com
RELAY_UPSTREAM_PATH=/v1/messages
RELAY_UPSTREAM_PORT=443
RELAY_UPSTREAM_PROTO=https

# Set to 1 to log one line per translated request (no message text, no keys)
RELAY_DUMP=1

# Per-model overrides. "*" is a catch-all in both maps.
# RELAY_MODEL_MAP=claude-sonnet-5-5=claude-sonnet-5-5-20260101,fast=claude-haiku-5-5
# RELAY_MAX_TOKENS_MAP=claude-haiku-5-5:32000,claude-opus-5-5:64000
# RELAY_MAX_TOKENS=32000

# Prompt caching: auto adds cache_control breakpoints, off disables.
# RELAY_CACHE_CONTROL=auto
# RELAY_CACHE_BREAKPOINTS=3

# Absolute path to node, for environments with a minimal PATH (launch agents).
# Leave empty to auto-detect.
# RELAY_NODE=/usr/local/bin/node
